# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Copy this file to `backend/.env` and update values as needed
MONGODB_URI=mongodb://127.0.0.1:27017/supportdesk

# JWT Secret
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# Optional: used to encrypt stored email passwords (recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# CORS
FRONTEND_URL=http://localhost:5173

# Inbound email auto sync (IMAP polling)
# When enabled, the backend will periodically poll IMAP and create tickets from new emails.
INBOUND_EMAIL_AUTO_SYNC_ENABLED=false
INBOUND_EMAIL_AUTO_SYNC_INTERVAL_SECONDS=60
INBOUND_EMAIL_AUTO_SYNC_RUN_ON_START=true
